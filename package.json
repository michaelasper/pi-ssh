{
  "name": "@michaelasper/pi-ssh",
  "version": "0.5.0",
  "license": "MIT",
  "description": "Optional SSH targeting for pi's bash and file tools",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "ssh"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelasper/pi-ssh.git"
  },
  "homepage": "https://github.com/michaelasper/pi-ssh#readme",
  "bugs": {
    "url": "https://github.com/michaelasper/pi-ssh/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck",
    "test:ssh": "node --test test/ssh.e2e.ts",
    "test:e2e": "sh scripts/ssh-e2e.sh",
    "test:package": "python3 scripts/package-smoke.py",
    "bench": "node scripts/bench.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "26.6.5",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "@google/genai": false,
    "esbuild": false,
    "protobufjs": false
  }
}
