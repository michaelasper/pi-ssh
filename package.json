{
  "name": "pi-ssh",
  "version": "0.1.0",
  "description": "Optional SSH targeting for pi's bash tool",
  "type": "module",
  "keywords": ["pi-package", "pi", "ssh"],
  "repository": { "type": "git", "url": "https://github.com/michaelasper/pi-ssh.git" },
  "files": ["src", "README.md", "docs"],
  "pi": { "extensions": ["./src/index.ts"] },
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck",
    "test:ssh": "node --test test/ssh.e2e.ts",
    "bench": "node scripts/bench.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  }
}
