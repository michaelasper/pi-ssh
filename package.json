{
  "name": "pi-ssh",
  "version": "0.1.0",
  "description": "Optional SSH targeting for pi's bash tool",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "ssh"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelasper/pi-ssh.git"
  },
  "files": [
    "src",
    "README.md",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck",
    "test:ssh": "node --test test/ssh.e2e.ts",
    "test:package": "python3 scripts/package-smoke.py",
    "bench": "node scripts/bench.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "26.4.1",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "@google/genai": false,
    "esbuild": false,
    "protobufjs": false
  }
}
